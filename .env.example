# Default provider and model for the UI, API and CLI
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3.5:9b

# Local backends (installed by you, not by this project).
# In Docker use http://host.docker.internal:11434/v1 and http://host.docker.internal:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Cloud APIs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Subscription CLIs through the host bridge (Docker only; leave empty for local runs)
CLI_BRIDGE_URL=
CLI_BRIDGE_TOKEN=

# Limits and tuning
MAX_PAGES=200
MAX_UPLOAD_MB=100
BATCH_CHARS=6000
LAYOUT_TOLERANCE_PT=5
RUNS_DIR=runs
